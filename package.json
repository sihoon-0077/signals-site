{
  "name": "signals-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "keys:generate": "tsx scripts/keygen.ts",
    "db:migrate": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/migrate.ts",
    "seed:dev": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/seed-dev.ts",
    "anchor": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/anchor.ts",
    "verify": "tsx scripts/verify.ts",
    "fixtures:tsa": "tsx scripts/fetch-tsa-fixture.ts",
    "vectors:canonical": "python scripts/gen_canonical_vectors.py",
    "keys:check": "tsx scripts/keys-check.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@electric-sql/pglite": "^0.5.11",
    "@vercel/functions": "^3.10.5",
    "asn1js": "^4.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.61.0",
    "next": "15.5.28",
    "pg": "^8.23.1",
    "pkijs": "^4.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite-socket": "^0.2.15",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "24.x"
  }
}
