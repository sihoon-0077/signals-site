# SIGNALS 사이트 환경변수. 로컬 개발은 .env.local, 배포는 Vercel 프로젝트 설정(Production에만)에 넣는다.
# 비워 두면 로컬 기본값(PGlite·개발용 키)으로 동작한다. Vercel 운영 빌드는 필수 값이 없거나 형식이 틀리면 빌드를 실패시킨다
# (조용히 임시 DB·새 키로 떨어지면 기록이 사라지거나 과거 서명이 전부 무효가 되기 때문). 값을 바꾸면 Redeploy해야 반영된다.

# 공개 주소(OG 이미지·공유 링크·검증 안내에 쓰임). 비우면 Vercel 운영 도메인(VERCEL_PROJECT_PRODUCTION_URL), 그것도 없으면 localhost.
SITE_URL=http://localhost:3000

# DB. 비우면 .data/pglite(로컬 파일 DB). Supabase는 "Transaction pooler" 연결 문자열(포트 6543)을 넣는다.
# 주소 끝에 ?sslmode=… 를 붙이지 않는다(운영 빌드가 멈추고 직전 배포가 그대로 서비스된다. 빌드 검사를 거치지 않은 실행에서는 DB를 쓰는 요청이 모두 CONFIG_INVALID).
# 인증서 확인은 DATABASE_CA_PEM으로 한다.
DATABASE_URL=
# (운영 Vercel에는 필수: 없으면 서버 인증서를 확인하지 않고 npm run smoke가 실패) Supabase SSL 인증서(prod-ca-2021.crt 내용 전체, 줄바꿈은 그대로 또는 \n).
# 있으면 DB 서버 인증서까지 확인한다. 인증서로 읽을 수 없는 값(잘림 등)이면 운영 빌드가 멈춘다. Vercel에서는 여러 줄 .env 일괄 붙여넣기에 넣지 말고 이 변수의 값 칸에 따로 넣는다.
# 없으면 암호화만 하고 인증서는 확인하지 않는다. localhost 주소는 TLS를 쓰지 않는다.
# DATABASE_CA_PEM=
# npm run db:migrate(그리고 DATABASE_URL을 넣고 실행한 npm run anchor)는 원격 DB인데 DATABASE_CA_PEM이 없으면(암호화만, 서버 인증서 확인 없음) 연결 전에 멈춘다(localhost 주소는 해당 없음).
# 인증서를 줄 수 없을 때 그 한 번의 실행에만 1로 지정한다(.env.local·Vercel에는 넣지 않는다).
# ALLOW_UNVERIFIED_TLS=
# 배포 모드(next start)를 로컬 PGlite로 시험할 때만 지정한다.
# PGLITE_DIR=.data/pglite

# 운영자 화면(/admin) HTTP Basic 인증. 둘 다 비우면 /admin은 503으로 닫힌다. 운영에서는 비밀번호 16자 미만이어도 닫힌다.
ADMIN_USER=
ADMIN_PASSWORD=

# 서명 키. `npm run keys:generate`가 홈 폴더의 .signals-keys/prod-keys.env(OneDrive 밖)에 만들어 준다.
# 로컬에서는 비워도 된다(.data/keys에 개발용 키 자동 생성). 6줄은 한 묶음으로 옮긴다(다른 묶음의 줄이 섞여 키 ID가 개인키와 짝이 아니면 운영 빌드가 멈춘다).
SIGNING_KEY_ID=
SIGNING_KEY_CREATED_AT=
SIGNING_PRIVATE_KEY_PEM=
CHECKPOINT_KEY_ID=
CHECKPOINT_KEY_CREATED_AT=
CHECKPOINT_PRIVATE_KEY_PEM=

# RFC 3161 타임스탬프 기관. 이름=주소 쉼표 구분. "off"면 요청하지 않는다(오프라인 테스트용).
# TSA_URLS=freetsa=https://freetsa.org/tsr,digicert=http://timestamp.digicert.com

# 일일 앵커 호출 비밀값. 공개 앵커 저장소의 GitHub Actions 비밀값(CRON_SECRET)과 같은 값을 넣는다.
# 비우면 /api/cron/anchor는 503으로 닫힌다. 만들기: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# 공개 앵커 저장소 주소(https://github.com/계정/signals-anchors). 검증 화면이 공개키·앵커를 여기서 직접 받아 대조한다.
ANCHOR_REPO_URL=
# 공개 저장소 기본 브랜치가 main이 아닐 때만
# ANCHOR_REPO_BRANCH=main

# 개인정보 처리방침의 보호책임자 이름과 문의 이메일(공개됨). 운영 빌드는 둘 다 있어야 통과한다.
PRIVACY_OFFICER=
CONTACT_EMAIL=
# CONTACT_EMAIL 메일함을 운영하는 업체(처리방침 3항에 공개됨, 운영 빌드 필수). 형식: 법인명(국가, 개인정보 문의처)
# 국가는 한글 국가 이름 하나로 적는다: 대한민국이면 처리 위탁으로, 그 밖의 국가면 국외 이전 항목까지 처리방침에 적힌다.
# 국내 업체는 대한민국만 적는다(도시 이름이나 다른 국가를 덧붙이면 위탁인지 국외 이전인지 정할 수 없어 운영 빌드가 멈춘다).
# CONTACT_EMAIL이 Gmail·네이버·다음(한메일)·카카오 메일 주소면 법인명에 그 메일함을 운영하는 회사 이름이 있어야 운영 빌드가 통과한다(예: gmail.com → Google).
# 문의처는 그 업체 개인정보 처리방침에 공개된 문의 이메일·https 주소·전화번호를 직접 확인해 적는다.
# 예(Gmail): Google LLC(미국, googlekrsupport@google.com)
# 첫 공개 뒤에 바꾸면 처리방침 8항대로 30일 전에 알려야 한다.
MAIL_SERVICE=

# 원격 DB에 쓰면서 개발용 키를 일부러 쓸 때만(시험용) 1
# ALLOW_DEV_KEYS=
# Vercel 미리보기(Preview) 배포에서 DB·키를 쓰는 것을 일부러 허용할 때만 1. 운영 DB를 미리보기에 주지 않는다.
# ALLOW_PREVIEW_DB=

# 로컬 시험용 앵커 스크립트(npm run anchor -- --local) 출력 폴더. 운영 앵커는 /api/cron/anchor(공개 저장소 자동 작업)가 만들고,
# 빠졌을 때 복구는 /admin의 '오늘(KST) 앵커 만들기' 버튼으로만 한다.
# ANCHOR_OUT_DIR=./anchors-out
